	public function comment_reply_count($data)
	{
		$res = $this->Mod_openvi->get_repl_count($data);
		// dbg($res);
		$z = "";
		if (is_array($res)) {
			if (count($res)) {
				foreach ($res as $key => $value) {
					$z .=  $value->cmnt_id . ",";
				}
				$z .= $this->comment_reply_count(substr($z, 0, -1));
			}
		}
		return $z;
	}
	public function comment_get_child($cmnt_id = '', $reply = '', $lmt, $load)
	{
		$limi 			 = 1;
		$limit 			 = "limit " . $limi;

		$load_child_more = "";
		$sisa 			 = $reply - $limi;
		$ul1 			 = "<ul class='ch-" . $cmnt_id . "'>";
		$ul2 			 = "</ul>";
		$style           = "rpdtl";
		if ($load == "child") {
			$total  = $this->Mod_openvi->get_comment_ttl("", "", $cmnt_id);
			// echo $total[0]->ttl." -".$reply;
			if ($total[0]->ttl > $sisa) {
				$limit = "limit " . $reply . "," . $lmt;
			}
			$ul1 = $ul2 = "";
		} else {
			if ($reply > $limi) {
				$load_child_more = "<div class='cmnt-reply2 load-child' id='rep-" . $cmnt_id . "' data-child='$reply'>lihat balasan lainnya <span>($sisa)</span></div>";
				if ($load != "default") {
					$limit = "limit " . $reply . "," . $limi;
				}
			}
			if ($load == "post") {
				$limit = "post";
				$style = "rpdtl";
			}
		}
		// echo $limit;
		$result = $this->Mod_openvi->get_comment_child($cmnt_id, $limit, "cmnt");
		echo json_encode(array("chld" => $result));
	}

	public function resort($obj, $tipe)
	{
		$hasil = (array_sort($obj, 'cd', SORT_ASC));
		foreach ($hasil as $key1 => $ajax) {
			$id  = $ajax->id;
			$nm  = $ajax->nme;
			$tgl = $ajax->tgl;
			$rep = $ajax->rpl;
			$shr = $ajax->dibagi;
			$chdr = $ajax->cnt_hdr;
			$cdtl = $ajax->cnt_dtl;
			if ($shr != "") {
				$txt = paragrap($ajax->txt, 20);
			} else {
				$txt = $ajax->txt;
			}
			// $ttl = $ajax->ttl;
			$ank = $ajax->chld;
			if ($tipe == "parent") {
				$sum = array_filter(explode(",", $this->comment_reply_count($id)));
				$ttl = count($sum);
			} else {
				$ttl = 0;
			}
			if (strlen($ank) == 0) {
				$arr[] = array("id" => $id, "nme" => $nm, "txt" => $txt, "tgl" => $tgl, "rpl" => $rep, "ttl" => $ttl, "chld" => $ank, "share" => $shr, "cnt_hdr" => $chdr, "cnt_dtl" => $cdtl);
			} else {
				$str = explode(",", $ank);
				foreach ($str as $key2 => $value) {
					$str2  = explode(":", $value);
					if (count($str2) > 1) {
						$dbg[$str2[0]] = $str2[1];
					} else {
						$dbg = $str2[0];
					}
				}
				$arr[] = array("id" => $id, "nme" => $nm, "txt" => $txt, "tgl" => $tgl, "rpl" => $rep, "ttl" => $ttl, "chld" => $dbg, "share" => $shr, "cnt_hdr" => $chdr, "cnt_dtl" => $cdtl);
			}
		}
		return $arr;
	}

	#21-08-10
	public function open_view($value = "", $value2 = "")
	{
		// echo $value . $value2;
		$dd = $this->input->request_headers();
		if (isset($dd["Wscr"])) {
			$layar = $dd["Wscr"];
		} else {
			$layar = "1024";
		};

		// dbg($dd);
		if (is_numeric($value)) {
			$result 		= $this->Mod_openvi->view_dtl($value);
			$data["result"] = $result;
			$data["tipe"]   = $value;
			$data["screen"] = $layar;
			$this->load->view("api/openview_dtl", $data);
		} else {
			$result 		= $this->Mod_openvi->view_hdr();
			// $data["result"] = json_encode($result);
			$data["result"] = $result;
			$data["tipe"]   = $value;
			$this->load->view("api/openview_hdr", $data);
		}
	}

