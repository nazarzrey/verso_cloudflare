	public function unic($salt = "")
	{
		if (strtoupper(substr(PHP_OS, 0, 3)) === 'WIN') {
			$temp = sys_get_temp_dir() . DIRECTORY_SEPARATOR . "diskpartscript.txt";
			if (!file_exists($temp) && !is_file($temp)) file_put_contents($temp, "select disk 0\ndetail disk");
			$output = shell_exec("diskpart /s " . $temp);
			$lines = explode("\n", $output);
			$result = array_filter($lines, function ($line) {
				return stripos($line, "ID:") !== false;
			});
			if (count($result) > 0) {
				$result = array_shift($result);
				$result = explode(":", $result);
				$result = trim(end($result));
			} else $result = $output;
		} else {
			$result = shell_exec("blkid -o value -s UUID");
			if (stripos($result, "blkid") !== false) {
				$result = $_SERVER['HTTP_HOST'];
			}
		}
		echo md5($salt . md5($result));
	}

	public function like($id, $content, $unic_device, $action = 0)
	{
		$content = str_replace("%20", " ", $content);
		if ($action == 1) {
			$result = $this->Mod_openvi->like($id, $content, $unic_device, 1);
		} else {
			$result = $this->Mod_openvi->like($id, $content, $unic_device);
		}
	}

	public function getlike($id = 0)
	{
		if ($id == 0) {
			$result = $this->Mod_openvi->getlike();
			$json   = json_encode($result);
			echo $json;
		} else {
			$result = $this->Mod_openvi->getlike($id);
			$json   = json_encode($result);
			echo $json;
		}
	}

	public function getbookmark($id = 0)
	{
		if ($id == 0) {
			$result = $this->Mod_openvi->getbookmark();
			$json   = json_encode($result);
			echo $json;
		} else {
			$result = $this->Mod_openvi->getbookmark($id);
			$json   = json_encode($result);
			echo $json;
		}
	}

	public function bookmark($id, $content, $unic_device, $action = 0)
	{
		$content = str_replace("%20", " ", $content);
		if ($action == 1) {
			$result = $this->Mod_openvi->bookmark($id, $content, $unic_device, 1);
		} else {
			$result = $this->Mod_openvi->bookmark($id, $content, $unic_device);
		}
	}

	public function collect($tipe = "", $edisi = "", $uid = "", $data = "")
	{
		if ($tipe == "hdr") {
			// get_hdr_openvi($edisi,$uid);
			$result = $this->Mod_openvi->get_hdr_openvi($edisi, $uid);
			echo json_encode($result);
		} else {
			$result = "";
		}
		if ($tipe == "comment_like_body") {
		}
		if ($tipe == "comment_get") {
			$lmt    	= 4;
			// die($data);
			// $start 		= round(microtime(true)*1000);
			$magz_edisi = $data;
			$magz_sect  = $edisi;
			$limit  	= "limit " . $lmt;
			#echo $data;
			if ($uid == "more-child") {
				$child_data = explode("-", str_replace("com-", "", $data));
				if (is_array($child_data)) {
					$child_id  = $child_data[0];
					$child_ttl = $child_data[1];
					$result = $this->comment_get_child($child_id, $child_ttl, $lmt, "child");
				}
				return;
			};
			$xdata      = 0;
			if ($data == "" || $data == 0) {
				$data	= $xdata;
			}
			if ($uid != "default") {
				if ($data != "0") {
					$limit = "limit " . $data . "," . $lmt;
				}
			}
			$result = $this->Mod_openvi->get_comment($magz_edisi, $magz_sect, $limit);
			$total  = $this->Mod_openvi->get_comment_ttl($magz_edisi, $magz_sect, "");
			$ttl_parent = $data;
			$load_more = "";
			if ($total) {
				if ($total[0]->ttl > $lmt) {
					$ttl_parent = $total[0]->ttl - $data;
					if ($ttl_parent >= $lmt) {
						$load_more = "<div class='load-parent'>lihat komentar lainnya</div>";
					}
				}
			}
			if ($result) {
				$resort = $this->resort($result, "parent");
				echo json_encode(array("chdr" => $resort));
			}
		}
		if ($tipe == "comment_get_more") {
			// trace("start");
			$lmt  = 4;
			$ortu = "40";
			$anak = "";
			if ($this->input->post()) {
				$ortu  = $this->input->post("cmnt_prnt");
				$anak  = $this->input->post("cmnt_chld");
			}
			$c_data = array_filter(explode(",", $this->comment_reply_count($ortu)));
			$c_dele = array_filter(explode(",", $anak));
			$res = array_diff($c_data, $c_dele);
			$cr_clean = "";
			foreach ($res as $key => $value) {
				$cr_clean .= $value . ",";
			}
			$cr_clean = substr($cr_clean, 0, -1);
			$result   = $this->Mod_openvi->get_repl_data($cr_clean, $lmt);
			#dbg($result);
			echo json_encode(array("chdr" => $result));
			// if($result){
			// 	$resort = $this->resort($result,"child");
			// 	echo json_encode(array("chdr"=>$resort));
			// }
			// trace("start");
			// echo $cr_clean;
			// echo json_encode(array("chdr"=>$get_reply));
			// code
			#$ss = $this->comment_reply_count("40");
			#dbg($ss);
			// $isi = $this->Mod_openvi->get_repl_text('50','cn6cc9y4s','nazrey keren')[0]->txt;
			// dbg($isi);


		}
		if ($tipe == "comment_post") {
			//echo json_encode("ok");
			if ($this->input->post()) {
				$cm_id  = $this->input->post("cid");
				$cm_uid = $this->input->post("cuid");
				$cm_nem = $this->input->post("cnam");
				$cm_eds = $this->input->post("cedisi");
				$cm_sec = $this->input->post("csection");
				$cm_isi = $this->input->post("comment");
				$cm_shr = $this->input->post("cshare");
				$save   = $this->Mod_openvi->post_comment($cm_id, $cm_uid, $cm_nem, $cm_eds, $cm_sec, $cm_isi, $cm_shr);
				if ($save) {
					$this->comment_get_child($save, "1", "1", "post");
				}
			} else {
				echo  json_encode(array("this post ajax"));
			}
		}
		if ($tipe == "content_post") {
			//echo json_encode("ok");
			if ($this->input->post()) {
				$cm_id  = $this->input->post("cid");
				$cm_uid = $this->input->post("cuid");
				$cm_nem = $this->input->post("cnam");
				$cm_eds = $this->input->post("cedisi");
				$cm_sec = $this->input->post("csection");
				$cm_isi = $this->input->post("comment");
				$cm_shr = $this->input->post("cshare");
				$cm_hdr = $this->input->post("cnt-hdr");
				$cm_dtl = paragrap($this->input->post("cnt-dtl"), 21);
				$save   = $this->Mod_openvi->post_content($cm_id, $cm_uid, $cm_nem, $cm_eds, $cm_sec, $cm_isi, $cm_shr, $cm_hdr, $cm_dtl);
				if ($save) {
					$result = $this->Mod_openvi->get_comment_child($save, "post", "cntn");
					echo json_encode(array("chld" => $result));
				}
			} else {
				echo  json_encode(array("this post ajax"));
			}
		}
		if ($tipe == "likebook") {
			if ($this->input->post()) {
				$cm_tp  = $this->input->post("tipe");
				$cm_uid = $this->input->post("uid");
				$cm_nem = $this->input->post("value");
				$cm_eds = $this->input->post("edisi");
				$cm_sec = $this->input->post("section");
				#debug($cm_tp,$cm_uid,$cm_nem,$cm_eds,$cm_sec);
				$save   = $this->Mod_openvi->post_likebook($cm_tp, $cm_uid, $cm_nem, $cm_eds, $cm_sec, "");
				if ($save) {
					echo  json_encode(array($cm_tp, "1"));
				} else {
					echo  json_encode(array($cm_tp, "0"));
				}
			} else {
				echo  json_encode(array("", "0"));
			}
		}
	}
