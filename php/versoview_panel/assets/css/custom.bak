/* body{margin:auto;font-size: 16px} */
.container{
  margin:auto;width:100%;text-align:center;
}
.img{cursor: pointer;}
/*p{
  margin:5px 0;
*/  /*border:solid 1px #ddd;*/
  /*padding: 10px;overflow: auto;*/
  /*min-height: 100vh;*/
  /*padding-bottom:10px;*/
/*}*/
p::first-letter {
  /*font-size: 200%;*/
  padding-left:20px;
}
.verso-ai{position:fixed;
  transform: rotate(135deg);
  right:-42px;
  bottom:-6px;
/*   border:solid 1px #ddd; */
  width:120px;
  height:50px;
/*   border-radius:50; */
  box-shadow:5px 5px 5px #ccc;
  background:#fff;z-index:999;}
.verso-ai img{margin:9px 5px 5px 5px}  
.verso-ai:active{box-shadow:1px 3px 5px tomato;}

.verso-ai2{position:fixed;
  transform: rotate(135deg);
  right:-40px;
  bottom:-8px;
/*   border:solid 1px #ddd; */
/*   border-radius:50; */
  background:#fff;
  z-index:999;
}
.verso-ai2 img{margin:0;padding:10px 40px;background: #fff}  
.verso-ai2:active{box-shadow:1px 3px 5px #fff;}
/* OpenView */
/*#OpenView{background:#fff;z-index:999;position:absolute;margin:auto;height:10000px;overflow: auto;width: 100%}*/
/*#OpenView div img{margin: 20px 0 !important;}*/
.view-page{
  border: solid 1px;width:25px;height:25px;padding: 10px;position: fixed;background: #fff;
  display: none
}
#OpenView{
  text-align: left;
  text-justify: inter-word;
}
