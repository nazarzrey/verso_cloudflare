function msg2($title,$text,$refresh){	
	if($title.length==0){
		$title = "Thank you";
	}else{
		$title = $title;
	}
/*	Swal.fire({
	  type: 'success',
	  title: 'Thank you \n for uploading your magazines',
	  text: 'Click the cover to convert for Web Page Turner and Android iOS apps!'
	  // footer: '<a href>Why do I have this issue?</a>'
	});
	*/
	Swal.fire({
		  title: $title,
		  text:  $text,
		  //type:  'success',
		  confirmButtonColor: '#ff2e44',
		  confirmButtonText: 'OK',
		  allowOutsideClick:false
		}).then((result) => {
		  if (result.value) {
		  	if($refresh.length==0){
		  		refresh("",100);
		  	}else{
		  		refresh($refresh,100);
		  	}
		  }
		})
}
