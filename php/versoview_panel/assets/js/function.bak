function loader(fungsi){
	if(fungsi=="s" || fungsi=="show"){
		$("#loader").fadeIn();
		//setTimeout(function(){ $("#loader").fadeOut(); }, 7500);
	}else if(fungsi=="unl"){
		$("#loader").fadeIn();
	}else{
		$("#loader").hide();		
	}
}
function loader2(fungsi){
	if(fungsi=="s" || fungsi=="show"){
		$("#loader2").fadeIn();
		//setTimeout(function(){ $("#loader").fadeOut(); }, 7500);
	}else if(fungsi=="unl"){
		$("#loader2").fadeIn();
	}else{
		$("#loader2").hide();		
	}
}
function issue_content($issue){
	var jqXHR = $.ajax({
		url   : base_url('xhr/issue/'+$issue),
		async : false
	});
	return jqXHR.responseText;	
}
function issue_cover($magz_id){
	var jqXHR = $.ajax({
		url   : base_url('xhr/issue_cover/'+$magz_id),
		async : false
	});
	return jqXHR.responseText;	
}
