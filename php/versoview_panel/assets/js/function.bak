function empty_check(array,id,$form){
	data = array.split(",");
	$result = "y";
	if(data.length>0){
		$.each(data,function(i){
			$element = elem(id)+data[i];
			//alert($element);
			$($element).removeClass("ver-brd4");
			if($($element).val().length==0){
				$($element).focus().addClass("ver-brd4");
				$(".message-info").show().html("empty input is required");
				$result = "n";
				return false;
			}else{
				if (data[i].indexOf('mail') >= 0) {
					$mail = $($element).val();
					if(mail($mail)=="X"){
						$($element).focus().addClass("ver-brd4");
						$(".message-info").show().html("this input must email");
						$result = "n";
						return false;
					}
				}
			}
		})
	}
	if($result=="y"){
		$(".message-info").show().toggleClass("alert-danger").html("process...");	
		//$($form+" .message-info").show().toggleClass("alert-danger").html("process...");	
	}
	return $result;
}
function elem(elem){
	if(elem=="id"){
		elem = "#";
	}else{
		elem = ".";
	}
	return elem;
}

function mail(v_mail){
	var testEmail = /^[A-Z0-9._%+-]+@([A-Z0-9-]+\.)+[A-Z]{2,4}$/i;
	if (testEmail.test(v_mail)){
		return "Y";
	}else{
		return "X";
	}
}

function refresh(url,time){
	setTimeout(
		function() {	
    	loader("hide");	
		window.location.href=url;					 
		},
	time);
}
function base_url($url){
	return $("#base-url").attr("data-id")+$url;
}
function fsz(kb){
	angka = 0;
	if(kb<1024){
		byte = "Kb";
		angka = kb / 1024;
	}else if(kb>=1024 || kb<1024000){
		byte = "Mb";
		angka = kb / 1024000;
	}else if(kb>=1024000 || kb<1024000000){
		byte = "Gb"
		angka = kb / 1024000000;
	}else{
		byte = "Tb";
		angka = kb / 1024000000000;
	} 
	return angka.toFixed(2)+" "+byte;
}
