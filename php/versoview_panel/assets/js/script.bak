function progress_convert($value,$num){	
	var refreshId = setInterval(function() {
	    $.getJSON(base_url("xhr/convert_progress/"+$value+"/"+$num),function(data,status,error){ 
	       if(status=="success"){
	       	//msg1(data);
					if(data[0]!=100){
						$(".progress2 .progress-bar").css("width",data[0]+"%");
					}else{						
    					clearInterval(refreshId);
						$(".progress2 .progress-bar").css("width","100%");	
				        $(".emagz-tittle-button .btn").hide();
				        msg1("Conversion completed\n click 'Now Publish Your Magazine'");
        				$(".st-4").show();
						//$("#edit-magz .st-5").attr("href",base_url(data[1]));
			        	//$("#edit-magz .st-5,.st-6").show();					
						setTimeout(
							function() {	
			        			$(".progress2").fadeOut();
							},
						1000);
					}
	        }else{
	            msg1(error);
	        }
	    });  
	}, 2000);
}
function blink(vclass){
	$("."+vclass).show()
	setInterval(function() {
	    $("."+vclass).fadeIn(300).fadeOut(500);
	}, 1000);
}