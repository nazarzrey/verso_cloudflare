$(document).ready(function(){
	$(".left-menu .xclose").click(function(){
		$(".cover-page").hide();
	})
	$(".xopen").click(function(){
		$(".cover-page").show();
	})
	$(".cover-page").click(function(){
		if($('.left-menu').is(':hover')==false){
			$(this).hide();
		}
	})
	$(".category").click(function(){
		$id = $(this).attr("id");
		//msg1($id);
		$(".data_cover").each(function(){
			$gid = $(this).attr("id");
			if($gid!=$id){
				$(this).hide();
			}else{
				$(this).fadeIn();
			}
		})
	})
	$(".category_all").click(function(){		
		$(".data_cover").fadeIn();
	})
	$(".edit-magz-button .fa-trash").click(function(){
		content = $(".edit-magz-slide-content");
		content.css({"width":"100%","border":"solid 1px tomato !important"});
		$("#edit-magz .keluar").hide();
	})
	$(".edit-magz-slide-content .close1").click(function(){
		$(".edit-magz-slide-content").css({"width":"0","border":"none"});	
		$("#edit-magz .keluar").show();	
	})
	$('#edit-magz').on('hide.bs.modal', function (event) {
	    $(this).find(".progress2").hide();
	    $(".progress2 .progress-bar").css("width","0");
	    clearInterval(event);
	})
    $('#edit-magz').on('show.bs.modal', function (event) {
        var btn   = $(event.relatedTarget); // Button that triggered the modal   
        var magz  = btn.data('magz'); // Extract info from data-* attributes
        var modal = $(this);
        var vcls  = btn.attr('class');
        var img   = btn.find('p').data('img');
        var txt   = "Total PDF page : "+btn.data('page');
        var cont  = JSON.parse(issue_content(magz));
        var xpath = cont.result["ipath"];
		//$id_class = "result-"+$frm_id.replace("#","").replace(".","");
        $(".emagz-tittle-button .btn").hide();
        if(cont.result["iconvert"]==0){
        	$(".st-2").show();
        }else if(cont.result["iconvert"]==1){
        	$(".st-3,.st-7").show();
        }else if(cont.result["iconvert"]==2  && cont.result["ipublish"]==0){
        	$(".st-4").show();
        }else{
			$(".st-5").attr("href",base_url(cont.result["dynamic_url"]));
        	$(".st-5,.st-6").show();
        }
        //msg1(cont.result["idesc"]);

	    modal.find(".progress2").hide();
        modal.find(".emagz-tittle-button h3").text(cont.result["ititle"]);
        modal.find(".emagz-img-desc").html("<p>"+cont.result["idesc"]+"</p>");
        modal.find(".emagz-img img").attr("src",img);
        //modal.find("#convert-issue,#convert-proses,#magazine-publish,#magazine-issue").attr("magz-id",magz);
		modal.find(".emagz-tittle-button").attr("magz-id",magz);
        modal.find(".issue-content-data").html(txt);
        modal.find(".edit-magz-button").attr("magz-id",magz);

        if(xpath && cont.result["iconvert"]==1){
        	var path  = xpath.replace("/","_");
	        modal.find(".progress2").fadeIn();
	        $(".progress2 .progress-bar").css("width","0");
			progress_convert(path,cont.result["ipage"]);
        }
    })
	/*register*/
	$("#frm-register button").click(function(){
		$id = "#"+$(this).parent("form").attr("id");
		if(empty_check("reg-name,reg-mail,reg-pass","id",$id)=="y"){
			$.ajax({
				type : 'POST',
				url  : base_url('ajax/user/register'),
				dataType : 'json',
				data : $($id).serialize(),
				success: function(data, status, xhr){
					if(data["status"]=="0"){
						$($id+" .message-info").show().removeClass("alert-info").addClass("alert-success").html("success, please wait");
						//msg1(base_url("login"));
						refresh(base_url("login"),"2000");
					}else{
						$($id+" .message-info").show().addClass("alert-danger").html("data already exists");
					}
				},
				error: function(xhr, status, error) {
					msg1(error)
				}
			})
		}
	})

	$("#frm-login button").click(function(){
		$id = "#"+$(this).parent("form").attr("id");
		if(empty_check("log-name,log-pass","id",$id)=="y"){
			$.ajax({
				type : 'POST',
				url  : base_url('ajax/user/login'),
				dataType : 'json',
				data : $($id).serialize(),
				success: function(data, status, xhr){
					if(data["status"]=="1"){
						$($id+" .message-info").show().removeClass("alert-info").addClass("alert-success").html("success, please wait");
						//msg1(base_url("login"));
						//refresh(base_url("login"),"2000");
						//msg1($id);
						$($id).submit();
					}else{
						$($id+" .message-info").show().addClass("alert-danger").html("user not found...!!!");
					}
				},
				error: function(xhr, status, error) {
					msg1(error)
				}
			})
		}
	})

	/*magazine created*/
	$("#image-holder").click(function() {
        $("input[id='my_file']").click();
    });
