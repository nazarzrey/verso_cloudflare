    $("#issue-conv").click(function(){
    	//loader("s");
    	$id = $(this).parent("div").attr("magz-id");
    	$("#edit-magz").find(".keluar").attr("data-dismiss","xmodal");
        $.get(base_url("xhr/convert_issue/"+$id),function(data,status,error){ 
           if(status=="success"){
				if(data=="cekfile"){
					$msg="convert error please check your pdf file or reupload file";
				}else{
           		  vData = data.split("_");
					if(vData[0]=="process"){
				        $(".emagz-tittle-button .btn").hide();				        
        				$(".st-3,.st-7").show();
				        $(".progress2").fadeIn();
						progress_convert(vData[1]+"_"+vData[2],vData[3]);
						//$msg="convert done go to publish button, for publish your magazine issue ";
					}
				}
        		loader("h");
            }else{
                msg1(error);
            }

        });   
    })	
